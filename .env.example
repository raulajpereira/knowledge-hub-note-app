# KnowledgeHub v2 — environment variables.
# Copy to .env (dev) or to the VPS deploy dir (prod, chmod 600). Never commit
# real values. Generate secrets with: openssl rand -hex 32

# ── App ──────────────────────────────────────────────────────────────────
NODE_ENV=development
# Public URL including the base path (used in emails / links).
APP_URL=http://localhost:3000
# Path the app is served from. "/v2" until the cut-over, then empty.
# Build-time for Next.js: the Docker image must be built with the same value.
NEXT_PUBLIC_BASE_PATH=

# ── PostgreSQL ───────────────────────────────────────────────────────────
# Runtime connection — the unprivileged kh_app role (RLS applies).
DATABASE_URL=postgres://kh_app:change-me-app@localhost:5432/knowledgehub
# Migrations — the schema owner (POSTGRES_USER in docker compose).
DATABASE_ADMIN_URL=postgres://kh_owner:change-me-owner@localhost:5432/knowledgehub
# Used by docker compose to initialise the database container.
POSTGRES_DB=knowledgehub
POSTGRES_USER=kh_owner
POSTGRES_PASSWORD=change-me-owner
KH_APP_DB_PASSWORD=change-me-app

# ── Redis ────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── MinIO / S3 ───────────────────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=kh-files
S3_ACCESS_KEY=kh-minio
S3_SECRET_KEY=change-me-minio
S3_FORCE_PATH_STYLE=true

# ── Encryption at rest (TOTP secrets, API Playground credentials) ────────
# 64 hex chars. Losing it makes those values unreadable. Not used by the
# password vault, which is end-to-end encrypted in the browser.
ENCRYPTION_KEY=

# ── Email (Hostinger SMTP) ───────────────────────────────────────────────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="KnowledgeHub <no-reply@knowledge-hub.cloud>"

# ── Component catalogue ──────────────────────────────────────────────────
# /ui is always available in development; set to true to also serve it from
# a production build (e.g. on the VPS while reviewing Phase 1).
KH_UI_CATALOG=false

# ── First super admin (created by the seed; gets a set-password link) ────
SUPERADMIN_EMAIL=
SUPERADMIN_NAME=

# ── Deploy (VPS only) ────────────────────────────────────────────────────
# Image tag pulled by docker compose (set by the deploy workflow).
KH_IMAGE_TAG=latest
KH_IMAGE_REPO=ghcr.io/raulajpereira/knowledgehub
# Host port the web container is published on (127.0.0.1 only) for the
# existing Nginx to proxy /v2 to, until Caddy takes over 80/443.
KH_WEB_PORT=3100
