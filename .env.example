# KnowledgeHub v2 — environment variables.
# Copy to .env (dev) or to the VPS deploy dir (prod, chmod 600). Never commit
# real values. Generate secrets with: openssl rand -hex 32

# ── App ──────────────────────────────────────────────────────────────────
NODE_ENV=development
# Public URL including the base path (used in emails / links).
APP_URL=http://localhost:3000
# Path the app is served from. "/v2" until the cut-over, then empty.
# Build-time for Next.js: the Docker image must be built with the same value.
NEXT_PUBLIC_BASE_PATH=

# ── PostgreSQL ───────────────────────────────────────────────────────────
# Runtime connection — the unprivileged kh_app role (RLS applies).
DATABASE_URL=postgres://kh_app:change-me-app@localhost:5432/knowledgehub
# Migrations — the schema owner (POSTGRES_USER in docker compose).
DATABASE_ADMIN_URL=postgres://kh_owner:change-me-owner@localhost:5432/knowledgehub
# Used by docker compose to initialise the database container.
POSTGRES_DB=knowledgehub
POSTGRES_USER=kh_owner
POSTGRES_PASSWORD=change-me-owner
KH_APP_DB_PASSWORD=change-me-app

# ── Redis ────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── MinIO / S3 ───────────────────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=kh-files
S3_ACCESS_KEY=kh-minio
S3_SECRET_KEY=change-me-minio
S3_FORCE_PATH_STYLE=true

# ── Encryption at rest (TOTP secrets, API Playground credentials, AI keys) ─
# 64 hex chars. Losing it makes those values unreadable. Not used by the
# password vault, which is end-to-end encrypted in the browser.
ENCRYPTION_KEY=

# ── Email (Hostinger SMTP) ───────────────────────────────────────────────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="KnowledgeHub <no-reply@knowledge-hub.cloud>"
# Without SMTP credentials emails are printed in the worker logs:
#   docker compose logs worker | grep -A8 "\[mail\]"
# MAIL_OUTBOX_DIR=/tmp/kh-outbox   # also write each email as JSON (tests)
# MAIL_DIRECT=false                # send inside the request instead of the queue (tests)

# ── Email para a app (inbound, optional) ─────────────────────────────────
# A Hostinger mailbox the worker reads by IMAP every 2 minutes: mail sent to
# <local>+<token>@<domain> becomes a note or task of the person with that token
# (Definições › Notificações shows each person their address). Leave empty to
# hide the feature. See docs/DEPLOY.md §5d.
INBOUND_IMAP_HOST=
INBOUND_IMAP_PORT=993
INBOUND_IMAP_USER=
INBOUND_IMAP_PASSWORD=
# the base address people write to (each one gets entrada+<token>@…)
INBOUND_ADDRESS=

# ── Assistente IA ────────────────────────────────────────────────────────
# Nothing to set: each person adds their own provider key in Definições ›
# Assistente IA (stored encrypted with ENCRYPTION_KEY). The server must be able
# to reach the providers' HTTPS APIs (api.groq.com, api.openai.com, …).
# AI_TEST_BASE_URL=http://127.0.0.1:4010  # TESTS ONLY: send every call to the local fake
#                                          # (tests/stubs/fakeAi.mjs). Never set in production.

# ── Weather on Início ────────────────────────────────────────────────────
# Forecast from MET Norway (api.met.no), warnings from IPMA (api.ipma.pt) for
# places in Portugal, place search from OpenStreetMap Nominatim; Open-Meteo
# only as a fallback. No keys. The server needs outbound HTTPS to those hosts.
# Their terms ask for an identifying User-Agent with a contact: empty =
# "KnowledgeHub/2.0 (+<APP_URL origin>)". Add a contact email if you like,
# e.g. KnowledgeHub/2.0 (+https://knowledge-hub.cloud; ops@your-domain).
WEATHER_USER_AGENT=
# WEATHER_TEST_BASE_URL=http://127.0.0.1:4011  # TESTS ONLY: every weather call goes to the
#                                              # local fake (tests/stubs/fakeWeather.mjs).

# ── Security ─────────────────────────────────────────────────────────────
# Reject new passwords found in known breaches (Have I Been Pwned, k-anonymity:
# only 5 hex chars of the SHA-1 leave the server). Needs outbound HTTPS.
HIBP_CHECK=true
# Cloudflare Turnstile (free; dash.cloudflare.com → Turnstile → add the site
# knowledge-hub.cloud). After 3 failed sign-ins for an email from one IP, or
# 10 from one IP within an hour, the login asks for the challenge. Leave both
# empty to rely only on the progressive lockout.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Admin Console (/admin and /api/admin) only from these IPs or CIDR ranges,
# comma separated, e.g. 203.0.113.7,198.51.100.0/24. Empty = any IP (2FA is
# always required).
ADMIN_IP_ALLOWLIST=

# ── Legal pages and landing (/terms, /privacy, contact on the home page) ─
# Who provides the service. Shown in the Terms and the Privacy Policy; the
# contact email also on the landing page. Until LEGAL_REVIEWED=true the legal
# pages carry a "provisional version" notice (texts drafted, to be reviewed).
LEGAL_ENTITY_NAME=
LEGAL_ENTITY_NIF=
LEGAL_ENTITY_ADDRESS=
LEGAL_CONTACT_EMAIL=
# date shown as "last updated" (YYYY-MM-DD)
LEGAL_UPDATED_AT=2026-10-08
LEGAL_REVIEWED=false

# ── Component catalogue ──────────────────────────────────────────────────
# /ui is always available in development; set to true to also serve it from
# a production build (e.g. on the VPS while reviewing Phase 1).
KH_UI_CATALOG=false

# ── First super admin (created by the seed; gets a set-password link) ────
SUPERADMIN_EMAIL=
SUPERADMIN_NAME=

# ── Deploy (VPS only) ────────────────────────────────────────────────────
# Image tag pulled by docker compose (set by the deploy workflow).
KH_IMAGE_TAG=latest
KH_IMAGE_REPO=ghcr.io/raulajpereira/knowledgehub
# Host port the web container is published on (127.0.0.1 only) for the
# existing Nginx to proxy /v2 to, until Caddy takes over 80/443.
KH_WEB_PORT=3100
# ── After the cut-over (docs/DEPLOY.md §7) ───────────────────────────────
# Caddy (profile "edge") serves the domain on 80/443 with automatic TLS.
# COMPOSE_PROFILES=edge makes every `docker compose up` (also the deploy
# workflow's) keep Caddy running; leave empty while Nginx serves /v2.
COMPOSE_PROFILES=
# email for the Let's Encrypt account (expiry notices)
ACME_EMAIL=
# apex domain (www redirects to it)
KH_DOMAIN=knowledge-hub.cloud

# ── Semantic search and OCR (worker; docs/DEPLOY.md §6c) ─────────────────
# Free, local, no API key: a small multilingual model (multilingual-e5-small,
# MIT) runs in the WORKER only; tesseract.js reads text in images / scanned
# PDFs. Either can be turned off (on/off); search then works by keyword only.
SEMANTIC_SEARCH=on
OCR=on
# where web asks the worker for query vectors (docker-compose.yml sets
# http://worker:3210; locally the worker listens on 127.0.0.1:3210)
EMBED_URL=http://127.0.0.1:3210
# worker side: address/port of that internal endpoint (never publish it)
EMBED_HOST=127.0.0.1
EMBED_PORT=3210
# Hugging Face model id (changing it re-embeds everything in the background)
EMBED_MODEL=Xenova/multilingual-e5-small
# model files (downloaded once from huggingface.co) + OCR languages; a volume in Docker
MODEL_CACHE_DIR=.cache/models
# free the model's memory (~350 MB) after this many idle minutes (0 = never)
EMBED_IDLE_MIN=60
# OCR skips files larger than this (MB) and reads at most this many PDF pages
OCR_MAX_MB=15
OCR_MAX_PAGES=20

# ── Maintenance ──────────────────────────────────────────────────────────
# The daily storage sweep only reports what it would delete (use for the
# first days after moving data); it also refuses on its own to delete when
# the database knows no file or more than a quarter of the bucket would go.
STORAGE_SWEEP_DRY_RUN=false
