# Used after the cut-over (COMPOSE_PROFILES=edge), when Caddy replaces the
# host Nginx on 80/443 and the v1 is gone (docs/DEPLOY.md §7):
#   https://knowledge-hub.cloud/  → the app (web container)
{
	email {$ACME_EMAIL}
}

{$KH_DOMAIN}, www.{$KH_DOMAIN} {
	encode zstd gzip

	@www host www.{$KH_DOMAIN}
	redir @www https://{$KH_DOMAIN}{uri} permanent

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	request_body {
		max_size 50MB
	}

	# Old bookmarks: the v1 is gone, the v2 left /v2.
	redir /v1 / permanent
	redir /v1/* / permanent
	redir /v2 / permanent
	@v2 path_regexp v2 ^/v2(/.*)$
	redir @v2 {re.v2.1}{?query} permanent

	handle {
		# the app reads the client IP (rate limits, audit, admin allowlist) from X-Real-IP
		reverse_proxy web:3000 {
			header_up X-Real-IP {remote_host}
		}
	}
}
