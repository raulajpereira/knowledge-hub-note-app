generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// member: regular account. admin: can generate invite codes and manage
// member/admin accounts. super_admin: the operator's own account — only
// modifiable by itself, never by other admins (exactly one super_admin is
// expected to exist, seeded via migration).
enum UserRole {
  member
  admin
  super_admin
}

// active: normal access. suspended: login/API blocked (data kept) — set by
// an admin who wants to pause an account without deleting it.
enum UserStatus {
  active
  suspended
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  name         String
  teamOwnerId  String?
  role         UserRole   @default(member)
  status       UserStatus @default(active)
  twoFactorSecret      String?  @db.Text // base32 TOTP secret, only present while 2FA is enabled
  twoFactorEnabled     Boolean  @default(false)
  twoFactorBackupCodes Json? // array of bcrypt-hashed one-time recovery codes, consumed on use
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  settings        Settings?
  folders         Folder[]
  notes           Note[]
  tasks           Task[]
  tags            Tag[]
  voiceNotes      VoiceNote[]
  passwordEntries PasswordEntry[]
  issues          Issue[]
  agents          Agent[]
  artifacts       Artifact[]
  artifactFolders ArtifactFolder[]
  savedNews       SavedNews[]
  codeFolders     CodeFolder[]
  codeItems       CodeItem[]
  links           Link[]
  templates       Template[]
  projects        Project[]
  sapTransactions SapTransaction[]
  docFolders      DocFolder[]
  documents       Document[]
  docTemplateRestrictions DocTemplateRestriction[]
  inviteCodes     InviteCode[] @relation("InviteCodeCreator")
  usedInviteCode  InviteCode?  @relation("InviteCodeUser")
  teamOwner       User?    @relation("TeamMembers", fields: [teamOwnerId], references: [id], onDelete: SetNull)
  teamMembers     User[]   @relation("TeamMembers")
  clients             Client[]
  sapSystems          SapSystem[]
  contacts            Contact[]
  transportRequests   TransportRequest[]
  auditLogs           AuditLog[] @relation("AuditActor")
  sessions            Session[]

  @@map("users")
}

model Project {
  id          String    @id @default(uuid())
  userId      String
  name        String
  icon        String? // emoji shown next to the project's name (Notion-style), null = default type icon
  coverUrl    String?   @db.Text // optional banner image shown above the name; never a default, purely opt-in
  scope       String?   @db.Text // "Âmbito"
  description String?   @db.Text
  company     String?
  notes       String?   @db.Text
  manager     String? // "Gestor de Projeto"
  contacts    Json? // [{ name, role, email, phone }]
  status      String    @default("Ativo") // Ativo | Pausado | Concluído
  startDate   String?
  endDate     String?
  color       String? // hue, reused as an accent for this project's issues
  favorite    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  transportRequests TransportRequest[]

  @@index([userId])
  @@map("projects")
}

model InviteCode {
  id            String    @id @default(uuid())
  code          String    @unique
  createdById   String
  createdBy     User      @relation("InviteCodeCreator", fields: [createdById], references: [id], onDelete: Cascade)
  usedById      String?   @unique
  usedBy        User?     @relation("InviteCodeUser", fields: [usedById], references: [id], onDelete: SetNull)
  usedAt        DateTime?
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())

  @@map("invite_codes")
}

model Settings {
  id                      String   @id @default(uuid())
  userId                  String   @unique
  theme                   String   @default("dark") // "dark" | "light"
  accentColor             String   @default("purple")
  accentHue               Int?
  fontFamily              String?
  fontScale               String   @default("medium") // "small" | "medium" | "large"
  radiusStyle             String   @default("default") // "sharp" | "default" | "round"
  density                 String   @default("comfortable") // "comfortable" | "compact"
  language                String   @default("pt") // "pt" | "en"
  logoUrl                 String?
  faviconUrl              String?
  avatarUrl               String?
  vaultSalt               String?  @db.Text
  vaultWrappedKey         String?  @db.Text
  vaultRecoveryWrappedKey String?  @db.Text
  vaultKdfIterations      Int?
  vaultAutoLockSeconds    Int      @default(60)
  issueStatuses           Json?
  trashRetentionDays      Int      @default(30) // 0 = never auto-purge
  sidebarLayout           Json? // [{ key: "notes", hidden: false }, ...] — order + visibility of sidebar nav items (Trash/Settings excluded, always shown)
  sidebarCollapsed        Boolean  @default(false) // icon-only sidebar mode
  homeLayout              Json? // { left: [...blockKeys], right: [...blockKeys] } — order of Home dashboard blocks per column
  hostingerApiTokenEnc    String?  @db.Text // AES-256-GCM encrypted at rest, server never exposes plaintext to the client
  hostingerVpsId          String?
  updatedAt               DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("settings")
}

model Folder {
  id        String   @id @default(uuid())
  userId    String
  parentId  String?
  name      String
  icon      String? // emoji shown next to the folder's name (Notion-style), null = default folder icon
  createdAt DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes    Note[]
  parent   Folder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Folder[] @relation("FolderTree")

  @@index([parentId])
  @@map("folders")
}

model Note {
  id        String    @id @default(uuid())
  userId    String
  folderId  String?
  parentNoteId String? // set = this note is a nested "page" living inside another note
  icon      String? // emoji shown next to the note's title (Notion-style), null = default note icon
  coverUrl  String? @db.Text // optional banner image shown above the title; never a default, purely opt-in
  title     String
  content   String    @db.LongText
  blocks    Json?
  tags      Json?
  links     Json?
  pinned    Boolean   @default(false)
  shareToken String?  @unique // set = publicly readable at /s/:shareToken, no auth; null = private
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder Folder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  parentNote Note?  @relation("NoteParent", fields: [parentNoteId], references: [id], onDelete: SetNull)
  childNotes Note[] @relation("NoteParent")
  versions NoteVersion[]

  @@index([userId])
  @@index([folderId])
  @@index([parentNoteId])
  @@map("notes")
}

model NoteVersion {
  id        String   @id @default(uuid())
  noteId    String
  title     String
  content   String   @db.LongText
  blocks    Json?
  createdAt DateTime @default(now())

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId, createdAt])
  @@map("note_versions")
}

model Task {
  id        String   @id @default(uuid())
  userId    String
  title     String
  done      Boolean  @default(false)
  status    String   @default("todo") // "todo" | "in_progress" | "done"
  priority  String   @default("Medium") // "Low" | "Medium" | "High"
  due       String?
  project   String?
  notes     String?  @db.Text
  favorite  Boolean  @default(false)
  recurrence String? // "daily" | "weekly" | "monthly"
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("tasks")
}

model Tag {
  id        String   @id @default(uuid())
  userId    String
  name      String
  hue       Int      @default(290)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@map("tags")
}

model VoiceNote {
  id        String   @id @default(uuid())
  userId    String
  title     String
  audioUrl  String
  duration  Int      @default(0)
  source    String   @default("mic") // "mic" | "system" — which input was captured
  notes     String?  @db.Text
  favorite  Boolean  @default(false)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("voice_notes")
}

model PasswordEntry {
  id        String   @id @default(uuid())
  userId    String
  envelope  String   @db.Text // base64(iv + AES-GCM ciphertext) of the JSON entry, encrypted client-side with the vault master key
  iconUrl   String? // optional custom icon upload; not encrypted — just a decorative image, overrides the auto site favicon
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_entries")
}

model Issue {
  id          String    @id @default(uuid())
  userId      String
  title       String
  description String?   @db.Text
  status      String    @default("Open") // Open | In Progress | Waiting | Done
  priority    String    @default("Medium") // Low | Medium | High | Critical
  waitingOn   String?
  completedAt DateTime?
  due         String?
  project     String?
  notes       String?   @db.Text
  favorite    Boolean   @default(false)
  recurrence  String? // "daily" | "weekly" | "monthly"
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("issues")
}

model Agent {
  id          String   @id @default(uuid())
  userId      String
  name        String
  provider    String   @default("anthropic") // "anthropic" | "openai"
  baseUrl     String?
  model       String?
  tokenCipher String   @db.Text
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AgentMessage[]

  @@index([userId])
  @@map("agents")
}

model AgentMessage {
  id        String   @id @default(uuid())
  agentId   String
  role      String // "user" | "assistant"
  content   String   @db.Text
  createdAt DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@map("agent_messages")
}

model Artifact {
  id          String   @id @default(uuid())
  userId      String
  folderId    String?
  title       String
  description String?  @db.Text
  html        String   @db.LongText
  tags        Json?
  favorite    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder ArtifactFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([folderId])
  @@map("artifacts")
}

// Same nested-folder shape as Notes' Folder model, kept separate so an
// artifact folder tree doesn't mix with the Notes one.
model ArtifactFolder {
  id        String   @id @default(uuid())
  userId    String
  parentId  String?
  name      String
  createdAt DateTime @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  artifacts Artifact[]
  parent    ArtifactFolder?  @relation("ArtifactFolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  ArtifactFolder[] @relation("ArtifactFolderTree")

  @@index([userId])
  @@index([parentId])
  @@map("artifact_folders")
}

model SavedNews {
  id        String   @id @default(uuid())
  userId    String
  newsId    String
  title     String
  source    String?
  image     String?  @db.Text
  summary   String?  @db.Text
  content   String?  @db.LongText
  link      String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, newsId])
  @@index([userId])
  @@map("saved_news")
}

model CodeFolder {
  id          String   @id @default(uuid())
  userId      String
  parentId    String?
  name        String // ABAP object name, e.g. ZMY_PROGRAM
  kind        String   @default("program") // "program" | "class" | "function_module"
  description String?  @db.Text
  tags        Json?
  linkedFolderIds Json?
  favorite    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  items    CodeItem[]
  parent   CodeFolder?  @relation("CodeFolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children CodeFolder[] @relation("CodeFolderTree")

  @@index([userId])
  @@index([parentId])
  @@map("code_folders")
}

model CodeItem {
  id         String   @id @default(uuid())
  folderId   String
  userId     String
  type       String // "snippet" | "characteristics" | "table" | "data_element" | "domain"
  name       String
  language   String   @default("abap")
  content    String?  @db.LongText
  attributes Json?
  position   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  folder CodeFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([folderId])
  @@index([userId])
  @@map("code_items")
}

// Generic cross-entity link — lets a Note/Issue/Task/CodeItem point at any
// other entity of any of those types, not just Note-to-Note (the older
// Note.links Json field). Kept separate from that field rather than
// migrating it, so the existing Notes-to-Notes linking UI/data is untouched.
model Link {
  id        String   @id @default(uuid())
  userId    String
  fromType  String // "note" | "issue" | "task" | "code"
  fromId    String
  toType    String
  toId      String
  label     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, fromType, fromId])
  @@index([userId, toType, toId])
  @@map("links")
}

// A personal catalog of SAP transaction codes / apps the user wants to keep
// track of. `usageCount` is bumped every time an entry is opened from the
// header quick-search popup or the page itself, powering "most searched".
model SapTransaction {
  id          String   @id @default(uuid())
  userId      String
  tcode       String // T-code or SuccessFactors admin-tool name, e.g. "PA30"
  description String   @db.Text
  module      String // e.g. "HCM · PA", "ABAP", "SuccessFactors · EC", "Basis"
  moduleGroup String // "ABAP" | "HCM" | "SuccessFactors" | "Basis" | "Outros"
  program     String? // underlying ABAP program, blank for SF/Fiori entries
  type        String   @default("Transação Standard")
  notes       String?  @db.Text
  favorite    Boolean  @default(false)
  usageCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sap_transactions")
}

// A saved starting point for a new Note/Task/Issue — `data` holds whatever
// fields that entity type's create form accepts (e.g. {title, blocks} for a
// note), applied as-is when the user picks the template.
model Template {
  id         String   @id @default(uuid())
  userId     String
  entityType String // "note" | "task" | "issue"
  name       String
  data       Json
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, entityType])
  @@map("templates")
}

// Same nested-folder shape as Notes' Folder model, kept separate so a
// Documentação folder tree doesn't mix with Notes'.
model DocFolder {
  id        String   @id @default(uuid())
  userId    String
  parentId  String?
  name      String
  createdAt DateTime @default(now())

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents Document[]
  parent    DocFolder?  @relation("DocFolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  DocFolder[] @relation("DocFolderTree")

  @@index([userId])
  @@index([parentId])
  @@map("doc_folders")
}

// A document template compiled offline (by analysing a real .docx) and
// shipped with a deploy — never created at runtime by end users. `fields`
// holds the ordered field-schema array ({key, type, label, ...config}) used
// to render the fill-in form; `sourceDocx` points at the tagged working copy
// (relative to server/templates/) the fill engine merges data into.
model DocTemplate {
  id          String   @id @default(uuid())
  name        String
  description String?  @db.Text
  fields      Json
  sourceDocx  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  restrictions DocTemplateRestriction[]
  documents    Document[]

  @@map("doc_templates")
}

// Default-allow: a template is visible to every user except the ones listed
// here. Keeps a newly added template usable by the whole team without
// needing to backfill a grant per user.
model DocTemplateRestriction {
  id         String @id @default(uuid())
  templateId String
  userId     String

  template DocTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([templateId, userId])
  @@map("doc_template_restrictions")
}

// A filled-in instance of a DocTemplate — the "nota" the user edits before
// generating the final .docx/pdf. fieldsData is keyed by each template
// field's `key`. Generated files are never persisted: exporting snapshots
// fieldsData into a DocumentVersion and streams the merged file on demand.
model Document {
  id         String    @id @default(uuid())
  userId     String
  folderId   String?
  templateId String
  icon       String? // emoji shown next to the document's title (Notion-style), null = default doc icon
  title      String
  fieldsData Json
  favorite   Boolean   @default(false)
  exportedAt DateTime?
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder   DocFolder?        @relation(fields: [folderId], references: [id], onDelete: SetNull)
  template DocTemplate       @relation(fields: [templateId], references: [id], onDelete: Restrict)
  versions DocumentVersion[]

  @@index([userId])
  @@index([folderId])
  @@map("documents")
}

// Snapshot of a Document's fieldsData taken every time "Gerar Documentação"
// runs, so past exports can be regenerated on demand without ever storing
// the generated binary.
model DocumentVersion {
  id         String   @id @default(uuid())
  documentId String
  fieldsData Json
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, createdAt])
  @@map("document_versions")
}

// A client company the team works with. Root of the SAP landscape data:
// Systems and Contacts hang off it, and Projects reference it by name today
// (Project.company stays free text — not migrated — so this is additive).
model Client {
  id        String   @id @default(uuid())
  userId    String
  name      String
  icon      String? // emoji shown next to the client's name (Notion-style), null = default client icon
  industry  String?
  notes     String?  @db.Text
  color     String?
  favorite  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  systems  SapSystem[]
  contacts Contact[]

  @@index([userId])
  @@map("clients")
}

// A single SAP system/environment in a client's landscape. The connection
// fields (sid, instanceNumber, saprouter, applicationServer) mirror SAP
// GUI's own "System Entry" dialog; `url` is for web-based systems that don't
// use that dialog at all (SuccessFactors, Fiori launchpads, ...). `environment`
// is free text so it isn't locked to DEV/QAS/PRD when a client's landscape
// uses more stages.
model SapSystem {
  id                String   @id @default(uuid())
  userId            String
  clientId          String?
  name              String // "Descrição" — e.g. "ECP - DEV"
  icon              String? // emoji shown next to the system's name (Notion-style), null = default system icon
  sid               String? // "ID sist." — 3-char system ID, e.g. "JOG"
  instanceNumber    String? // "Nº da instância" — e.g. "00"
  saprouter         String? @db.Text // "Cadeia de SAProuter"
  applicationServer String? // "Servidor de aplicação" — e.g. "vaciJOG"
  environment       String   @default("PRD")
  url               String?  @db.Text // web-based systems without SAP GUI connection params (SuccessFactors, Fiori, ...)
  notes             String?  @db.Text
  favorite          Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  client            Client?            @relation(fields: [clientId], references: [id], onDelete: SetNull)
  contacts          Contact[]
  transportRequests TransportRequest[]

  @@index([userId])
  @@index([clientId])
  @@map("sap_systems")
}

// A key-contact entry (Basis, key user, functional consultant, …) for a
// Client and/or a specific SapSystem — both are optional so a contact can be
// client-wide or scoped to one system.
model Contact {
  id        String   @id @default(uuid())
  userId    String
  clientId  String?
  systemId  String?
  name      String
  icon      String? // emoji shown next to the contact's name (Notion-style), null = default contact icon
  role      String?
  email     String?
  phone     String?
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  client Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  system SapSystem? @relation(fields: [systemId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([clientId])
  @@index([systemId])
  @@map("contacts")
}

// A live, queryable Transport Request registry — the same data that ends up
// baked into a Documentação "Ordens de Transporte" table, but kept as
// structured rows per project so its liberada/QAS/PRD state is actually
// searchable instead of living only inside generated .docx files.
model TransportRequest {
  id           String   @id @default(uuid())
  userId       String
  projectId    String?
  systemId     String?
  code         String // e.g. "20260730-RP-FI"
  icon         String? // emoji shown next to the transport request's code (Notion-style), null = default icon
  description  String   @db.Text
  environment  String? // "Ambiente Mandante e Origem" free text, matches the docx column
  liberada     Boolean  @default(false)
  transportQas Boolean  @default(false)
  transportPrd Boolean  @default(false)
  plannedDate  String? // surfaced on the Calendar page when set
  notes        String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  system  SapSystem? @relation(fields: [systemId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([projectId])
  @@map("transport_requests")
}

// A cross-team activity trail, visible only to the super_admin account.
// Written by a generic response-finish hook (see server/src/lib/auditLog.js)
// covering every authenticated mutating request, so it's complete by
// construction rather than depending on each route remembering to log —
// content bodies are never recorded, only what/who/when, so it stays safe
// even for entities like Passwords whose payloads are sensitive.
// `actor` is nullable/SetNull so a deleted account's history isn't lost.
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actorName  String
  actorEmail String
  teamId     String // effectiveUserId of the workspace affected
  entityType String // URL segment right after /api/, e.g. "notes", "clients"
  entityId   String?
  action     String // "create" | "update" | "delete" | "login" | "login_failed" | "register"
  summary    String? @db.Text
  ip         String?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([teamId, createdAt])
  @@index([actorId])
  @@index([entityType, createdAt])
  @@map("audit_logs")
}

// A tracked login session — lets the account owner see and revoke active
// sessions, and is the mechanism 2FA hooks into (a session isn't considered
// fully authenticated until `verifiedAt` is set, if the account has 2FA on).
model Session {
  id          String    @id @default(uuid())
  userId      String
  jti         String    @unique
  userAgent   String?
  ip          String?
  createdAt   DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  verifiedAt  DateTime?
  revokedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}
